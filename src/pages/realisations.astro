---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectPreview from "../components/ui/ProjectPreview.astro";
---

<BaseLayout
  title="Réalisations de sites internet sur mesure | Happyclicks"
  description="Découvrez des sites internet réellement conçus sur mesure par Happyclicks : industrie, événementiel, beauté et projets pensés pour chaque activité."
>
  <main class="work-page">
    <section class="work-hero">
      <div class="work-hero__inner">
        <p class="work-hero__eyebrow">Réalisations & projets</p>

        <h1 class="work-hero__title">
          De vrais sites, conçus<br />
          <span>projet par projet<span class="work-hero__dot">.</span></span>
        </h1>

        <p class="work-hero__intro">
          Pas de template simplement recoloré. Je construis la structure,
          l’univers graphique et le développement autour du besoin réel de
          chaque projet. Les aperçus montrent plusieurs vues de chaque site, sur ordinateur
          comme sur mobile.
        </p>
      </div>
    </section>

    <section class="work-list" aria-label="Projets réalisés">
      <div class="work-list__inner">
        <article class="work-card">
          <a
            href="/realisations/polymaintenance/"
            class="work-card__visual"
            aria-label="Découvrir le projet Polymaintenance"
          >
            <ProjectPreview
              desktopImages={[
                "/images/projects/carousel/polymaintenance/desktop-1.webp",
                "/images/projects/carousel/polymaintenance/desktop-2.webp",
                "/images/projects/carousel/polymaintenance/desktop-3.webp",
              ]}
              mobileImages={[
                "/images/projects/carousel/polymaintenance/mobile-1.webp",
                "/images/projects/carousel/polymaintenance/mobile-2.webp",
                "/images/projects/carousel/polymaintenance/mobile-3.webp",
              ]}
              label="Aperçus du site Polymaintenance sur ordinateur et téléphone"
              eager={true}
            />
          </a>

          <div class="work-card__content">
            <p class="work-card__meta">Industrie · Refonte · Négoce</p>
            <h2 class="work-card__title">Polymaintenance</h2>
            <p class="work-card__text">
              Une refonte complète pour clarifier les activités, renforcer la
              place du négoce, améliorer le référencement local et permettre à
              l’entreprise de gérer elle-même ses annonces depuis un espace
              d’administration privé, y compris sur téléphone.
            </p>

            <div class="work-card__tags" aria-label="Fonctionnalités principales">
              <span>Architecture sur mesure</span>
              <span>Admin annonces mobile</span>
              <span>Responsive</span>
              <span>SEO local</span>
            </div>

            <div class="work-card__actions">
              <a href="/realisations/polymaintenance/" class="work-card__link">
                <span>Découvrir le projet</span>
                <span aria-hidden="true">→</span>
              </a>
              <a href="https://polymaintenance.fr/" class="work-card__link work-card__link--external" target="_blank" rel="noopener noreferrer">
                <span>Voir le site en ligne</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>

        <article class="work-card">
          <a
            href="/realisations/anais-glen/"
            class="work-card__visual"
            aria-label="Découvrir le projet Anaïs & Glen"
          >
            <ProjectPreview
              desktopImages={[
                "/images/projects/carousel/anais-glen/desktop-1.webp",
                "/images/projects/carousel/anais-glen/desktop-2.webp",
                "/images/projects/carousel/anais-glen/desktop-3.webp",
              ]}
              mobileImages={[
                "/images/projects/carousel/anais-glen/mobile-1.webp",
                "/images/projects/carousel/anais-glen/mobile-2.webp",
                "/images/projects/carousel/anais-glen/mobile-3.webp",
              ]}
              label="Aperçus du site de mariage Anaïs & Glen sur ordinateur et téléphone"
            />
          </a>

          <div class="work-card__content">
            <p class="work-card__meta">Événementiel · Site de mariage</p>
            <h2 class="work-card__title">Anaïs & Glen</h2>
            <p class="work-card__text">
              Un site conçu à l’origine pour un vrai mariage : identité douce,
              compte à rebours jusqu’au jour J, programme, informations pratiques,
              dress code, souvenirs et formulaire RSVP.
            </p>

            <div class="work-card__tags" aria-label="Fonctionnalités principales">
              <span>Mobile first</span>
              <span>Compte à rebours</span>
              <span>RSVP</span>
              <span>Programme</span>
              <span>Univers graphique</span>
            </div>

            <div class="work-card__actions">
              <a href="/realisations/anais-glen/" class="work-card__link">
                <span>Découvrir le projet</span>
                <span aria-hidden="true">→</span>
              </a>
              <a href="https://anais-et-glen.fr/" class="work-card__link work-card__link--external" target="_blank" rel="noopener noreferrer">
                <span>Voir le site en ligne</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>

        <article class="work-card work-card--progress">
          <a
            href="/realisations/appart-beaute/"
            class="work-card__visual"
            aria-label="Découvrir le projet Appart & Beauté"
          >
            <ProjectPreview
              desktopImages={[
                "/images/projects/carousel/appart-beaute/desktop-1.webp",
                "/images/projects/carousel/appart-beaute/desktop-2.webp",
                "/images/projects/carousel/appart-beaute/desktop-3.webp",
              ]}
              mobileImages={[
                "/images/projects/carousel/appart-beaute/mobile-1.webp",
                "/images/projects/carousel/appart-beaute/mobile-2.webp",
                "/images/projects/carousel/appart-beaute/mobile-3.webp",
              ]}
              label="Aperçus du site Appart & Beauté sur ordinateur et téléphone"
            />
          </a>

          <div class="work-card__content">
            <p class="work-card__meta">Beauté · Refonte en cours</p>
            <h2 class="work-card__title">Appart & Beauté</h2>
            <p class="work-card__text">
              Nouvelle direction artistique, approche mobile first, mise en
              avant du Lash Lift Coréen et du Browlift, réservation Planity et
              travail du référencement local.
            </p>

            <div class="work-card__tags" aria-label="Points forts du projet">
              <span>Mobile first</span>
              <span>SEO local</span>
              <span>Planity</span>
              <span>Lash Lift Coréen</span>
              <span>Browlift</span>
            </div>

            <div class="work-card__actions">
              <a href="/realisations/appart-beaute/" class="work-card__link">
                <span>Découvrir le projet</span>
                <span aria-hidden="true">→</span>
              </a>
              <a href="https://www.appartbeauteinstitut.com/" class="work-card__link work-card__link--external" target="_blank" rel="noopener noreferrer">
                <span>Voir le site en ligne</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>

            <span class="work-card__status">Projet en cours de finalisation</span>
          </div>
        </article>
      </div>
    </section>

    <section class="work-cta">
      <div class="work-cta__inner">
        <p class="work-cta__eyebrow">Votre projet</p>
        <h2>
          Votre site aussi peut partir<br />
          <span>d’une vraie page blanche<span class="work-hero__dot">.</span></span>
        </h2>
        <p>
          Parlez-moi de votre activité, de ce qui existe aujourd’hui et de ce
          que vous aimeriez améliorer. Quelques lignes suffisent pour commencer.
        </p>
        <a href="/contact/" class="work-cta__button">
          <span>Présenter mon projet</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .work-page { overflow: hidden; }
  .work-hero { background: var(--color-ivory); }
  .work-hero__inner, .work-list__inner, .work-cta__inner {
    width: min(calc(100% - 2rem), var(--content-max));
    margin-inline: auto;
  }
  .work-hero__inner { padding-block: clamp(3.5rem, 7vw, 7rem) clamp(3rem, 5vw, 5rem); }
  .work-hero__eyebrow, .work-cta__eyebrow {
    margin-bottom: 1rem; color: var(--color-teal); font-size: .72rem;
    font-weight: 600; letter-spacing: .09em; text-transform: uppercase;
  }
  .work-hero__title { max-width: 980px; font-size: clamp(3rem, 6vw, 6.4rem); line-height: .95; letter-spacing: -.035em; }
  .work-hero__title span, .work-cta h2 span { color: var(--color-teal); }
  .work-hero__dot { color: var(--color-coral) !important; }
  .work-hero__intro { max-width: 700px; margin-top: 2rem; font-size: clamp(1rem, 1.2vw, 1.12rem); line-height: 1.75; }
  .work-list { background: linear-gradient(180deg, rgba(229,243,241,.42), rgba(250,247,240,.45)); }
  .work-list__inner { padding-block: clamp(3.5rem, 7vw, 7rem); }
  .work-card { display: grid; gap: 2.5rem; align-items: center; }
  .work-card + .work-card { margin-top: clamp(5rem, 10vw, 9rem); }
  .work-card__visual { display: block; min-width: 0; color: inherit; }
  .work-card__meta { margin-bottom: .7rem; color: var(--color-teal); font-size: .7rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .work-card__title { font-size: clamp(2.2rem, 4vw, 4.2rem); line-height: 1; }
  .work-card__text { max-width: 520px; margin-top: 1.3rem; line-height: 1.75; }
  .work-card__tags { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.4rem; }
  .work-card__tags span, .work-card__status { padding: .45rem .7rem; background: rgba(15,159,143,.09); border-radius: 999px; color: #087a71; font-size: .7rem; font-weight: 600; }
  .work-card__actions { display:flex; flex-wrap:wrap; gap:.65rem 1.4rem; margin-top:1.5rem; }
  .work-card__link { position: relative; display: inline-flex; align-items: center; gap: .8rem; margin-top: 0; padding-bottom: .35rem; font-family: var(--font-heading); font-size: 1.18rem; font-style: italic; }
  .work-card__link::after { content:""; position:absolute; right:0; bottom:0; left:0; height:1px; background:var(--color-teal); }
  .work-card__link span:last-child { color: var(--color-teal); }
  .work-card__link--external { color: rgba(11,37,48,.72); }
  .work-card__status { display: inline-flex; margin-top: 1.5rem; text-transform: uppercase; letter-spacing: .05em; }
  .browser-frame { position: relative; width: 100%; padding-top: 34px; overflow: hidden; background:#fff; border:1px solid rgba(11,37,48,.12); border-radius:18px 18px 50px 18px; box-shadow:0 20px 50px rgba(11,37,48,.09); }
  .browser-frame::before { content:""; position:absolute; inset:0 0 auto; height:34px; background:var(--color-ivory); border-bottom:1px solid rgba(11,37,48,.08); }
  .browser-frame::after { content:""; position:absolute; top:14px; left:16px; width:6px; height:6px; border-radius:50%; background:var(--color-coral); box-shadow:12px 0 0 rgba(15,159,143,.45),24px 0 0 rgba(11,37,48,.18); }
  .browser-frame img { display:block; width:100%; aspect-ratio:16/9; object-fit:cover; object-position:top; }
  .work-cta { background: var(--color-ink); color: var(--color-ivory); }
  .work-cta__inner { padding-block: clamp(4rem, 8vw, 7rem); }
  .work-cta h2 { max-width: 900px; font-size: clamp(2.7rem, 5vw, 5.2rem); line-height: .98; }
  .work-cta p:not(.work-cta__eyebrow) { max-width: 620px; margin-top: 1.7rem; color: rgba(250,247,240,.76); line-height:1.7; }
  .work-cta__button { display:inline-flex; align-items:center; gap:1rem; margin-top:2rem; min-height:52px; padding:.8rem 1.5rem; border:1.5px solid var(--color-teal); border-radius:999px; }
  .work-cta__button span:last-child { color: var(--color-teal); }
  @media (min-width:768px) {
    .work-hero__inner,.work-list__inner,.work-cta__inner { width:min(calc(100% - 4rem),var(--content-max)); }
    .work-card { grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr); gap:clamp(3rem,7vw,7rem); }
    .work-card:nth-child(even) > :first-child { order:2; }
    .work-card:nth-child(even) .work-card__content { order:1; }
  }
  @media (max-width:767px) {
    .work-hero__title { font-size: clamp(3rem, 13vw, 4.2rem); }
    .work-card + .work-card { margin-top: 5rem; }
  }
</style>
