           ÉTAPE 01
           =================================== -->

      <article class="journey-step">
        <span class="journey-step__number"> 01 </span>

        <div class="journey-step__content">
          <h3 class="journey-step__title">On se raconte</h3>

          <p class="journey-step__text">
            On échange sur votre activité, votre histoire, vos envies et les
            personnes auxquelles vous souhaitez parler.
          </p>

          <p class="journey-step__note">Comprendre avant de créer.</p>
        </div>
      </article>

      <!-- ===================================
           ÉTAPE 02
           =================================== -->

      <article class="journey-step journey-step--middle">
        <span class="journey-step__number"> 02 </span>

        <div class="journey-step__content">
          <h3 class="journey-step__title">On imagine</h3>

          <p class="journey-step__text">
            Je construis la direction du projet : structure, univers graphique,
            contenus et expérience de navigation.
          </p>

          <p class="journey-step__note">Trouver la forme juste.</p>
        </div>
      </article>

      <!-- ===================================
           ÉTAPE 03
           =================================== -->

      <article class="journey-step">
        <span class="journey-step__number"> 03 </span>

        <div class="journey-step__content">
          <h3 class="journey-step__title">On donne vie</h3>

          <p class="journey-step__text">
