---
import StoryThread from "../decorative/StoryThread.astro";
---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow">Création de sites web sur mesure</p>

      <h1 class="hero__title">
        Un site qui ne se contente pas<br />
        <span>
          d’être beau<span class="hero__dot">.</span>
        </span>
      </h1>

      <div class="hero__thread">
        <StoryThread />
      </div>

      <p class="hero__description">
        Clair, élégant et pensé pour votre activité : pour inspirer confiance,
        mieux présenter votre offre et transformer vos visiteurs en contacts.
      </p>

      <p class="hero__signature">Chaque projet mérite son histoire.</p>

      <div class="hero__actions">
        <a class="hero__primary" href="/contact">
          <span>Parlons de votre projet</span>
          <span aria-hidden="true">→</span>
        </a>

        <a class="hero__secondary" href="/realisations">
          <span>Voir les réalisations</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 110px);
    overflow: hidden;
  }

  .hero__inner {
    width: min(calc(100% - 2rem), var(--content-max));
    margin-inline: auto;
    padding-block: clamp(2rem, 5vh, 5rem);
  }

  .hero__content {
    width: min(100%, 960px);
  }

  .hero__eyebrow {
    margin-bottom: 1rem;
    color: var(--color-teal);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__title {
    font-size: clamp(3.4rem, 6vw, 6.2rem);
    line-height: 0.94;
    letter-spacing: -0.035em;
  }

  .hero__title > span {
    color: var(--color-teal);
  }

  .hero__dot {
    color: var(--color-coral);
  }

  .hero__thread {
    width: 100vw;
    margin-top: -2.25rem;
    margin-left: calc((100vw - 100%) / -2);
    margin-bottom: -1.25rem;
  }

  .hero__description {
    max-width: 660px;
    margin-top: 2.5rem;
    font-size: clamp(1rem, 1.25vw, 1.15rem);
    line-height: 1.65;
  }

  .hero__signature {
    margin-top: 1.1rem;
    color: var(--color-teal);
    font-family: var(--font-heading);
    font-size: 1.08rem;
    font-style: italic;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 3rem;
    margin-top: 2rem;
  }

  .hero__primary {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-height: 52px;
    padding: 0.8rem 1.5rem;
    border: 1.5px solid var(--color-teal);
    border-radius: 999px;
    transition:
      transform var(--transition-base),
      background-color var(--transition-base);
  }

  .hero__primary:hover,
  .hero__primary:focus-visible {
    background-color: var(--color-mist);
    transform: translateY(-2px);
  }

  .hero__secondary {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.5rem;
  }

  .hero__secondary::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--color-teal);
    transform-origin: left;
    transition: transform var(--transition-base);
  }

  .hero__secondary:hover::after,
  .hero__secondary:focus-visible::after {
    transform: scaleX(1.08);
  }

  @media (min-width: 768px) {
    .hero__inner {
      width: min(calc(100% - 4rem), var(--content-max));
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: auto;
    }

    .hero__inner {
      padding-top: 0.5rem;
      padding-bottom: 5rem;
    }

    .hero__eyebrow {
      font-size: 0.7rem;
    }

    .hero__title {
      font-size: clamp(3rem, 14vw, 4.2rem);
      line-height: 0.94;
    }

    .hero__thread {
      width: calc(100% + 2rem);
      margin-top: 0.5rem;
      margin-left: -1rem;
      margin-bottom: -1rem;
    }

    .hero__description {
      margin-top: 2rem;
      font-size: 0.98rem;
    }

    .hero__actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
  }
</style>
