---
const services = [
  {
    title: "Création de site",
    text: "Un site vitrine sur mesure, clair, rapide et pensé autour de votre activité et de vos objectifs.",
  },
  {
    title: "Refonte",
    text: "Repenser un site devenu daté, peu clair ou inefficace, sans perdre ce qui fait déjà votre identité.",
  },
  {
    title: "Identité visuelle & logo",
    text: "Créer ou faire évoluer votre image pour que votre site et votre communication restent cohérents.",
  },
  {
    title: "Fonctionnalités utiles",
    text: "Formulaires, catalogue, demandes de devis ou contenus spécifiques : uniquement ce qui sert vraiment votre activité.",
  },
  {
    title: "Référencement local",
    text: "Des bases techniques et éditoriales solides pour aider les bonnes personnes à vous trouver.",
  },
  {
    title: "Domaine & hébergement",
    text: "Je vous accompagne pour le domaine, l’hébergement et la mise en ligne, avec des accès qui restent à votre nom.",
  },
];
---

<section class="services-section" id="services">
  <div class="services-section__inner">
    <header class="services-section__header">
      <p class="services-section__eyebrow">Services</p>
      <h2 class="services-section__title">
        Ce qu’il faut pour<br />
        <span>faire avancer votre présence en ligne<span>.</span></span>
      </h2>
      <p class="services-section__intro">
        Pas de pack rempli d’options inutiles. On construit la solution qui a du
        sens pour votre activité aujourd’hui, et qui pourra évoluer demain.
      </p>
    </header>

    <div class="services-section__grid">
      {services.map((service) => (
        <article class="service-card">
          <h3 class="service-card__title">{service.title}</h3>
          <p class="service-card__text">{service.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    position: relative;
    background: var(--color-ink);
    color: var(--color-ivory);
  }

  .services-section__inner {
    width: min(calc(100% - 2rem), var(--content-max));
    margin-inline: auto;
    padding-block: clamp(3rem, 4vw, 4rem);
  }

  .services-section__header {
    max-width: 900px;
    margin-bottom: clamp(2.75rem, 4vw, 4rem);
  }

  .services-section__eyebrow {
    margin-bottom: 1rem;
    color: var(--color-teal);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .services-section__title {
    font-size: clamp(2.7rem, 5vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .services-section__title > span {
    color: var(--color-teal);
  }

  .services-section__title > span span {
    color: var(--color-coral);
  }

  .services-section__intro {
    max-width: 590px;
    margin-top: 1.7rem;
    color: rgba(250, 247, 240, 0.78);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .services-section__grid {
    display: grid;
    gap: 1px;
    background: rgba(250, 247, 240, 0.12);
    border: 1px solid rgba(250, 247, 240, 0.12);
    border-radius: 24px 60px 24px 24px;
    overflow: hidden;
  }

  .service-card {
    min-height: 180px;
    padding: clamp(1.7rem, 2.5vw, 2.5rem);
    background: var(--color-ink);
  }

  .service-card__title {
    margin-top: 0;
    font-size: clamp(1.65rem, 2.2vw, 2.35rem);
    line-height: 1.03;
  }

  .service-card__text {
    max-width: 390px;
    margin-top: 1rem;
    color: rgba(250, 247, 240, 0.72);
    line-height: 1.65;
  }

  @media (min-width: 768px) {
    .services-section__inner {
      width: min(calc(100% - 4rem), var(--content-max));
    }

    .services-section__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .services-section__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .services-section__inner {
      padding-block: 3rem;
    }

    .services-section__title {
      font-size: clamp(2.6rem, 12vw, 3.6rem);
    }

    .service-card {
      min-height: auto;
    }
  }
</style>
