---
import ProjectPreview from "../ui/ProjectPreview.astro";
---

<section class="projects-section" id="realisations">
  <div class="projects-section__inner">
    <header class="projects-section__header">
      <p class="projects-section__eyebrow">Des projets réellement sur mesure</p>

      <h2 class="projects-section__title">
        Chaque site part<br />
        <span>
          d’une page blanche<span class="projects-section__dot">.</span>
        </span>
      </h2>

      <p class="projects-section__intro">
        Je conçois la structure, l’univers graphique et le développement pour
        chaque projet. Les aperçus ci-dessous permettent de parcourir plusieurs vues de
        chaque projet, sur ordinateur comme sur mobile.
      </p>
    </header>

    <article class="project project--featured">
      <a
        href="/realisations/polymaintenance/"
        class="project__visual"
        aria-label="Découvrir le projet Polymaintenance"
      >
        <ProjectPreview
              desktopImages={[
                "/images/projects/carousel/polymaintenance/desktop-1.webp",
                "/images/projects/carousel/polymaintenance/desktop-2.webp",
                "/images/projects/carousel/polymaintenance/desktop-3.webp",
              ]}
              mobileImages={[
                "/images/projects/carousel/polymaintenance/mobile-1.webp",
                "/images/projects/carousel/polymaintenance/mobile-2.webp",
                "/images/projects/carousel/polymaintenance/mobile-3.webp",
              ]}
              label="Aperçus du site Polymaintenance sur ordinateur et téléphone"
              eager={true}
            />
      </a>

      <div class="project__content">
        <p class="project__type">Industrie · Site vitrine & négoce</p>
        <h3 class="project__title">Polymaintenance</h3>
        <p class="project__description">
          Refonte complète d’un site industriel : nouvelle architecture,
          identité modernisée, référencement local et espace d’administration
          privé pour gérer les annonces de matériel directement depuis un téléphone.
        </p>
        <div class="project__actions">
          <a href="/realisations/polymaintenance/" class="project__link">
            <span>Découvrir le projet</span>
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="https://polymaintenance.fr/"
            class="project__link project__link--external"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Voir le site en ligne</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </article>

    <article class="project project--wedding">
      <a
        href="/realisations/anais-glen/"
        class="project__visual"
        aria-label="Découvrir le projet Anaïs & Glen"
      >
        <ProjectPreview
              desktopImages={[
                "/images/projects/carousel/anais-glen/desktop-1.webp",
                "/images/projects/carousel/anais-glen/desktop-2.webp",
                "/images/projects/carousel/anais-glen/desktop-3.webp",
              ]}
              mobileImages={[
                "/images/projects/carousel/anais-glen/mobile-1.webp",
                "/images/projects/carousel/anais-glen/mobile-2.webp",
                "/images/projects/carousel/anais-glen/mobile-3.webp",
              ]}
              label="Aperçus du site de mariage Anaïs & Glen sur ordinateur et téléphone"
            />
      </a>

      <div class="project__content">
        <p class="project__type">Événementiel · Site de mariage</p>
        <h3 class="project__title">Anaïs & Glen</h3>
        <p class="project__description">
          Un site conçu à l’origine pour un vrai mariage : univers graphique
          sur mesure, compte à rebours jusqu’au jour J, programme, informations
          pratiques, dress code, RSVP et expérience mobile soignée.
        </p>
        <div class="project__actions">
          <a href="/realisations/anais-glen/" class="project__link">
            <span>Découvrir le projet</span>
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="https://anais-et-glen.fr/"
            class="project__link project__link--external"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Voir le site en ligne</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </article>

    <article class="project project--beauty project--in-progress">
      <a
        href="/realisations/appart-beaute/"
        class="project__visual"
        aria-label="Découvrir le projet Appart & Beauté"
      >
        <ProjectPreview
              desktopImages={[
                "/images/projects/carousel/appart-beaute/desktop-1.webp",
                "/images/projects/carousel/appart-beaute/desktop-2.webp",
                "/images/projects/carousel/appart-beaute/desktop-3.webp",
              ]}
              mobileImages={[
                "/images/projects/carousel/appart-beaute/mobile-1.webp",
                "/images/projects/carousel/appart-beaute/mobile-2.webp",
                "/images/projects/carousel/appart-beaute/mobile-3.webp",
              ]}
              label="Aperçus du site Appart & Beauté sur ordinateur et téléphone"
            />
      </a>

      <div class="project__content">
        <p class="project__type">Beauté · Refonte en cours</p>
        <h3 class="project__title">Appart & Beauté</h3>
        <p class="project__description">
          Refonte complète d’un institut de beauté : nouvelle direction
          artistique, mobile first, mise en avant du Lash Lift Coréen et du
          Browlift, réservation Planity et travail du SEO local.
        </p>
        <div class="project__actions">
          <a href="/realisations/appart-beaute/" class="project__link">
            <span>Découvrir le projet</span>
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="https://www.appartbeauteinstitut.com/"
            class="project__link project__link--external"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Voir le site en ligne</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
        <span class="project__status">Projet en cours de finalisation</span>
      </div>
    </article>

    <div class="projects-section__footer">
      <a href="/realisations/" class="projects-section__all">
        <span>Voir toutes les réalisations</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .projects-section {
    position: relative;
    overflow: hidden;
    background: var(--color-ivory);
  }

  .projects-section__inner {
    width: min(calc(100% - 2rem), var(--content-max));
    margin-inline: auto;
    padding: clamp(2.5rem, 3.5vw, 3.5rem) 0 clamp(3rem, 4vw, 4rem);
  }

  .projects-section__header {
    max-width: 850px;
    margin-bottom: clamp(2.75rem, 4vw, 4rem);
  }

  .projects-section__eyebrow {
    margin-bottom: 1rem;
    color: #087a71;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .projects-section__title {
    font-size: clamp(2.7rem, 5vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .projects-section__title > span {
    color: var(--color-teal);
  }

  .projects-section__dot {
    color: var(--color-coral);
  }

  .projects-section__intro {
    max-width: 660px;
    margin-top: 1.7rem;
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .project {
    display: grid;
    gap: 2.5rem;
    min-width: 0;
    align-items: center;
  }

  .project + .project {
    margin-top: clamp(4.5rem, 8vw, 8rem);
  }

  .project__visual {
    display: block;
    min-width: 0;
    color: inherit;
  }

  .project__content {
    align-self: center;
  }

  .project__type {
    margin-bottom: 0.7rem;
    color: #087a71;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project__title {
    font-size: clamp(2rem, 3vw, 3.4rem);
    line-height: 1;
  }

  .project__description {
    max-width: 500px;
    margin-top: 1.3rem;
    line-height: 1.7;
  }

  .project__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.4rem;
    margin-top: 1.5rem;
  }

  .project__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 0;
    padding-bottom: 0.35rem;
    font-family: var(--font-heading);
    font-size: 1.18rem;
    font-style: italic;
  }

  .project__link::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--color-teal);
    transform-origin: left;
    transition: transform var(--transition-base);
  }

  .project__link:hover::after,
  .project__link:focus-visible::after {
    transform: scaleX(1.06);
  }

  .project__link span:last-child {
    color: var(--color-teal);
  }

  .project__link--external {
    color: rgba(11, 37, 48, 0.72);
  }

  .project__status {
    display: inline-flex;
    margin-top: 1.5rem;
    padding: 0.5rem 0.8rem;
    background: var(--color-mist);
    border-radius: 999px;
    color: #087a71;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project__device {
    position: relative;
    width: 100%;
    padding-top: 34px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(11, 37, 48, 0.12);
    border-radius: 18px 18px 50px 18px;
    box-shadow: 0 20px 50px rgba(11, 37, 48, 0.09);
  }

  .project__device::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 34px;
    background: var(--color-ivory);
    border-bottom: 1px solid rgba(11, 37, 48, 0.08);
  }

  .project__device::after {
    content: "";
    position: absolute;
    top: 14px;
    left: 16px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-coral);
    box-shadow: 12px 0 0 rgba(15, 159, 143, 0.45), 24px 0 0 rgba(11, 37, 48, 0.18);
  }

  .project__picture,
  .project__image {
    display: block;
    width: 100%;
  }

  .project__image {
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
  }

  .projects-section__footer {
    display: flex;
    justify-content: flex-end;
    margin-top: clamp(3.5rem, 6vw, 5.5rem);
  }

  .projects-section__all {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.8rem 1.25rem;
    border: 1px solid rgba(11, 37, 48, 0.18);
    border-radius: 999px;
    transition: background-color var(--transition-base), transform var(--transition-base);
  }

  .projects-section__all:hover,
  .projects-section__all:focus-visible {
    background: var(--color-mist);
    transform: translateY(-2px);
  }

  .projects-section__all span:last-child {
    color: var(--color-teal);
  }

  @media (min-width: 768px) {
    .projects-section__inner {
      width: min(calc(100% - 4rem), var(--content-max));
    }

    .project {
      grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
      gap: clamp(3rem, 7vw, 7rem);
    }

    .project:nth-of-type(even) .project__visual {
      order: 2;
    }

    .project:nth-of-type(even) .project__content {
      order: 1;
    }
  }

  @media (max-width: 767px) {
    .projects-section__title {
      font-size: clamp(2.6rem, 12vw, 3.7rem);
    }

    .project + .project {
      margin-top: 5rem;
    }

    .project__content {
      padding-inline: 0.25rem;
    }
  }
</style>
