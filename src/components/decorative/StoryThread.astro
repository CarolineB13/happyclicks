<style>
  .story-thread {
    pointer-events: none;
    color: var(--color-teal);
  }

  .story-thread svg {
    width: 100%;
    overflow: visible;

    clip-path: inset(0 100% 0 0);
    animation: reveal-thread 2.6s cubic-bezier(0.65, 0, 0.35, 1) 0.1s forwards;
  }

  .story-thread path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .story-thread__desktop {
    display: none;
  }

  .story-thread__mobile {
    display: block;
    height: 90px;
  }

  @keyframes reveal-thread {
    from {
      clip-path: inset(0 100% 0 0);
    }

    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (min-width: 768px) {
    .story-thread__desktop {
      display: block;
      height: 150px;
    }

    .story-thread__mobile {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-thread svg {
      animation: none;
      clip-path: none;
    }
  }
</style>
