---
const whatsappNumber = (import.meta.env.PUBLIC_WHATSAPP_NUMBER || "").replace(/\D/g, "");
const defaultMessage = encodeURIComponent(
  "Bonjour Caroline, je vous contacte depuis le site Happyclicks au sujet d’un projet web."
);
const whatsappUrl = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${defaultMessage}`
  : null;
---

{whatsappUrl && (
  <a
    class="whatsapp-button"
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contacter Happyclicks sur WhatsApp"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20.5 11.8a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.3-4.3A8.5 8.5 0 1 1 20.5 11.8Z" />
      <path d="M8.5 7.8c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .5.4l.8 1.9c.1.3.1.5-.1.7l-.6.8c-.2.2-.1.4 0 .6.7 1.2 1.6 2.1 2.8 2.8.2.1.4.2.6 0l.9-1.1c.2-.2.4-.3.7-.2l1.8.9c.3.1.5.2.5.4.1.2.1 1-.2 1.7-.3.8-1.5 1.5-2.2 1.6-.6.1-1.4.2-2.3-.1-1.2-.4-2.8-1.1-4.7-2.8-1.6-1.5-2.7-3.4-3-4.6-.3-1.2 0-2 .3-2.6Z" />
    </svg>
    <span>WhatsApp</span>
  </a>
)}

<style>
  .whatsapp-button {
    position: fixed;
    left: 1.25rem;
    bottom: 1.25rem;
    z-index: var(--z-overlay);
    display: inline-flex;
    align-items: center;
    width: 54px;
    min-height: 54px;
    padding: 0 16px;
    overflow: hidden;
    background: var(--color-teal);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    color: #fff;
    box-shadow: 0 12px 30px rgba(11, 37, 48, 0.18);
    transition:
      width 320ms cubic-bezier(0.22, 1, 0.36, 1),
      transform var(--transition-base),
      box-shadow var(--transition-base),
      background-color var(--transition-base);
  }

  .whatsapp-button svg {
    flex: 0 0 22px;
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.55;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .whatsapp-button span {
    margin-left: 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(6px);
    transition:
      opacity 160ms ease 60ms,
      transform 220ms ease 40ms;
  }

  .whatsapp-button:hover,
  .whatsapp-button:focus-visible {
    width: 145px;
    background: #0c8d80;
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(11, 37, 48, 0.23);
  }

  .whatsapp-button:hover span,
  .whatsapp-button:focus-visible span {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 767px) {
    .whatsapp-button {
      left: auto;
      right: max(1rem, env(safe-area-inset-right, 0px));
      bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
      z-index: var(--z-modal);

      display: flex;
      align-items: center;
      justify-content: center;

      width: 58px;
      height: 58px;
      min-height: 58px;
      padding: 0;

      border: 2px solid rgba(255, 255, 255, 0.78);
      box-shadow:
        0 12px 30px rgba(11, 37, 48, 0.28),
        0 0 0 4px rgba(15, 159, 143, 0.08);
    }

    .whatsapp-button svg {
      flex-basis: 25px;
      width: 25px;
      height: 25px;
    }

    .whatsapp-button:hover,
    .whatsapp-button:focus-visible {
      width: 58px;
      transform: translateY(-2px);
    }

    .whatsapp-button span {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-button,
    .whatsapp-button span {
      transition: none;
    }
  }
</style>
