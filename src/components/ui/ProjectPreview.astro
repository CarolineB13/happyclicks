---
interface Props {
  desktopImages: string[];
  mobileImages: string[];
  label: string;
  eager?: boolean;
}

const {
  desktopImages,
  mobileImages,
  label,
  eager = false,
} = Astro.props;
---

<div class="project-preview" aria-label={label} data-project-carousel>
  <div class="project-preview__desktop" aria-hidden="true">
    <div class="project-preview__browserbar">
      <span></span><span></span><span></span>
    </div>

    <div class="project-preview__slides project-preview__slides--desktop">
      {desktopImages.map((src, index) => (
        <img
          src={src}
          alt=""
          class:list={["project-preview__slide", index === 0 && "is-active"]}
          loading={eager && index === 0 ? "eager" : "lazy"}
          decoding="async"
          data-carousel-slide
        />
      ))}
    </div>
  </div>

  <div class="project-preview__phone" aria-hidden="true">
    <div class="project-preview__speaker"></div>

    <div class="project-preview__slides project-preview__slides--mobile">
      {mobileImages.map((src, index) => (
        <img
          src={src}
          alt=""
          class:list={["project-preview__slide", index === 0 && "is-active"]}
          loading={eager && index === 0 ? "eager" : "lazy"}
          decoding="async"
          data-carousel-mobile-slide
        />
      ))}
    </div>
  </div>

  <div class="project-preview__dots" aria-hidden="true">
    {mobileImages.map((_, index) => (
      <span class:list={["project-preview__dot", index === 0 && "is-active"]} data-carousel-dot></span>
    ))}
  </div>
</div>

<script>
  const carousels = document.querySelectorAll<HTMLElement>("[data-project-carousel]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  carousels.forEach((carousel) => {
    const desktopSlides = Array.from(
      carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"),
    );
    const mobileSlides = Array.from(
      carousel.querySelectorAll<HTMLElement>("[data-carousel-mobile-slide]"),
    );
    const dots = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-dot]"));
    const length = Math.max(desktopSlides.length, mobileSlides.length);

    if (length <= 1 || reducedMotion) return;

    let current = 0;
    let timer: number | undefined;

    const show = (index: number) => {
      current = index % length;
      desktopSlides.forEach((slide, i) => slide.classList.toggle("is-active", i === current % desktopSlides.length));
      mobileSlides.forEach((slide, i) => slide.classList.toggle("is-active", i === current % mobileSlides.length));
      dots.forEach((dot, i) => dot.classList.toggle("is-active", i === current % dots.length));
    };

    const start = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => show(current + 1), 4300);
    };

    const stop = () => window.clearInterval(timer);

    carousel.addEventListener("mouseenter", stop);
    carousel.addEventListener("mouseleave", start);
    carousel.addEventListener("focusin", stop);
    carousel.addEventListener("focusout", start);

    start();
  });
</script>

<style>
  .project-preview {
    position: relative;
    width: 100%;
    padding: 0 8% 7% 0;
  }

  .project-preview__desktop {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #fff;
    border: 1px solid rgba(11, 37, 48, 0.12);
    border-radius: 18px 18px 50px 18px;
    box-shadow: 0 24px 60px rgba(11, 37, 48, 0.1);
  }

  .project-preview__browserbar {
    position: absolute;
    inset: 0 0 auto;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding-left: 16px;
    background: var(--color-ivory);
    border-bottom: 1px solid rgba(11, 37, 48, 0.08);
  }

  .project-preview__browserbar span {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-coral);
  }

  .project-preview__browserbar span:nth-child(2) {
    background: rgba(15, 159, 143, 0.45);
  }

  .project-preview__browserbar span:nth-child(3) {
    background: rgba(11, 37, 48, 0.18);
  }

  .project-preview__slides {
    position: absolute;
    overflow: hidden;
  }

  .project-preview__slides--desktop {
    inset: 34px 0 0;
  }

  .project-preview__slide {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0;
    transform: scale(1.004);
    transition: opacity 650ms ease, transform 1.2s ease;
  }

  .project-preview__slide.is-active {
    z-index: 2;
    opacity: 1;
    transform: scale(1);
  }

  .project-preview__phone {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 5;
    width: clamp(112px, 23%, 178px);
    aspect-ratio: 512 / 1010;
    overflow: hidden;
    background: #fff;
    border: 5px solid var(--color-ink);
    border-radius: 24px;
    box-shadow: 0 18px 38px rgba(11, 37, 48, 0.22);
  }

  .project-preview__speaker {
    position: absolute;
    top: 6px;
    left: 50%;
    z-index: 6;
    width: 28%;
    height: 6px;
    border-radius: 999px;
    background: var(--color-ink);
    transform: translateX(-50%);
  }

  .project-preview__slides--mobile {
    inset: 0;
  }

  .project-preview__dots {
    position: absolute;
    right: 8%;
    bottom: 1.5%;
    display: flex;
    gap: 5px;
    z-index: 8;
  }

  .project-preview__dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: rgba(11, 37, 48, 0.2);
    transition: width 300ms ease, background-color 300ms ease;
  }

  .project-preview__dot.is-active {
    width: 16px;
    background: var(--color-teal);
  }

  @media (max-width: 767px) {
    .project-preview {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0;
    }

    .project-preview__desktop {
      display: none;
    }

    .project-preview__phone {
      position: relative;
      right: auto;
      bottom: auto;
      width: min(66vw, 255px);
      border-width: 5px;
      border-radius: 28px;
      box-shadow: 0 20px 46px rgba(11, 37, 48, 0.18);
    }

    .project-preview__dots {
      position: static;
      margin-top: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-preview__slide {
      transition: none;
    }
  }
</style>
