---
const items = [
  { number: "01", label: "Réalisations", href: "/realisations" },
  { number: "02", label: "Votre projet", href: "/votre-projet" },
  { number: "03", label: "À propos", href: "/a-propos" },
  { number: "04", label: "Journal", href: "/journal" },
  { number: "05", label: "Contact", href: "/contact" },
];
---

<div class="mobile-menu" data-mobile-menu>
  <!-- ======================================
       COIN DE PAGE — OUVERTURE DU MENU
       ====================================== -->

  <button
    class="mobile-menu__trigger"
    type="button"
    aria-label="Ouvrir le menu"
    aria-expanded="false"
    aria-controls="mobile-navigation"
    data-menu-trigger
  >
    <img
      src="/images/ui/page-corner.webp"
      alt=""
      aria-hidden="true"
      class="mobile-menu__trigger-image"
    />
  </button>

  <!-- ======================================
       MENU OUVERT
       ====================================== -->

  <div
    class="mobile-menu__panel"
    id="mobile-navigation"
    aria-hidden="true"
    data-menu-panel
  >
    <!-- Haut du menu -->
    <div class="mobile-menu__top">
      <img
        src="/images/brand/happyclicks-h.svg"
        alt=""
        aria-hidden="true"
        class="mobile-menu__logo"
      />

      <button
        class="mobile-menu__close"
        type="button"
        aria-label="Fermer le menu"
        data-menu-close
      >
        <span></span>
        <span></span>
      </button>
    </div>

    <!-- Contenu -->
    <div class="mobile-menu__content">
      <!-- Fil vertical -->
      <svg
        class="mobile-menu__thread"
        viewBox="0 0 80 520"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          d="
            M 44 -20

            C 24 48, 58 85, 39 140
            C 25 180, 30 214, 43 242

            C 54 265, 55 286, 42 306
            C 29 326, 26 347, 39 365

            C 53 384, 58 405, 43 426
            C 25 451, 28 491, 55 545
          "
        ></path>
      </svg>

      <!-- Navigation -->
      <nav class="mobile-menu__nav" aria-label="Navigation mobile">
        {
          items.map((item) => (
            <a class="mobile-menu__item" href={item.href}>
              <span class="mobile-menu__number">{item.number}</span>

              <span class="mobile-menu__label">{item.label}</span>
            </a>
          ))
        }
      </nav>

      <p class="mobile-menu__note">Suivez le fil</p>
    </div>

    <!-- Coin inférieur de la page -->
    <div class="mobile-menu__fold" aria-hidden="true"></div>
  </div>
</div>

<script>
  const menu = document.querySelector("[data-mobile-menu]");
  const trigger = menu?.querySelector("[data-menu-trigger]");
  const panel = menu?.querySelector("[data-menu-panel]");
  const close = menu?.querySelector("[data-menu-close]");

  const openMenu = () => {
    if (!menu || !trigger || !panel) return;

    menu.classList.add("is-open");

    trigger.setAttribute("aria-expanded", "true");

    panel.setAttribute("aria-hidden", "false");

    document.body.classList.add("menu-open");
  };

  const closeMenu = () => {
    if (!menu || !trigger || !panel) return;

    menu.classList.remove("is-open");

    trigger.setAttribute("aria-expanded", "false");

    panel.setAttribute("aria-hidden", "true");

    document.body.classList.remove("menu-open");
  };

  trigger?.addEventListener("click", openMenu);

  close?.addEventListener("click", closeMenu);

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeMenu();
    }
  });
</script>

<style>
  /* ========================================
     CONTENEUR
     ======================================== */

  .mobile-menu {
    display: block;
  }

  /* ========================================
     COIN DE PAGE — MENU FERMÉ
     ======================================== */

  .mobile-menu__trigger {
    position: fixed;

    top: 0;
    right: 0;

    z-index: calc(var(--z-navigation) + 20);

    width: 105px;
    height: 105px;

    padding: 0;

    background: transparent;

    overflow: visible;

    transition:
      transform 350ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 350ms ease;
  }

  .mobile-menu__trigger-image {
    position: absolute;

    top: 0;
    right: 0;

    display: block;

    width: 105px;
    height: 105px;

    object-fit: contain;
    object-position: top right;

    pointer-events: none;

    transform-origin: top right;

    transition:
      transform 400ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 400ms ease;
  }

  .mobile-menu__trigger:hover .mobile-menu__trigger-image,
  .mobile-menu__trigger:focus-visible .mobile-menu__trigger-image {
    transform: scale(1.055) rotate(-1deg);

    filter: drop-shadow(-3px 5px 5px rgba(11, 37, 48, 0.08));
  }

  .mobile-menu__trigger:active .mobile-menu__trigger-image {
    transform: scale(1.02) rotate(0deg);
  }

  /* ========================================
     PAGE DU MENU
     ======================================== */

  .mobile-menu__panel {
    position: fixed;

    inset: 0;

    z-index: calc(var(--z-navigation) + 30);

    display: flex;
    flex-direction: column;

    overflow: hidden;

    background: linear-gradient(
      145deg,
      var(--color-teal) 0%,
      #0c7771 70%,
      var(--color-ink) 145%
    );

    color: var(--color-ivory);

    visibility: hidden;

    transform: translateX(105%);

    transition:
      transform 650ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 650ms;
  }

  .is-open .mobile-menu__panel {
    visibility: visible;

    transform: translateX(0);
  }

  /* ========================================
     HAUT DU MENU
     ======================================== */

  .mobile-menu__top {
    position: relative;

    z-index: 2;

    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    padding: 1.4rem 1.3rem;
  }

  .mobile-menu__logo {
    width: 43px;
    height: auto;

    filter: brightness(0) invert(1);

    opacity: 0.95;
  }

  /* ========================================
     BOUTON FERMER
     ======================================== */

  .mobile-menu__close {
    position: relative;

    width: 42px;
    height: 42px;

    color: var(--color-ivory);

    transition: transform var(--transition-base);
  }

  .mobile-menu__close:hover,
  .mobile-menu__close:focus-visible {
    transform: rotate(5deg);
  }

  .mobile-menu__close span {
    position: absolute;

    top: 50%;
    left: 50%;

    width: 24px;
    height: 1px;

    background: currentColor;

    transform-origin: center;
  }

  .mobile-menu__close span:first-child {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .mobile-menu__close span:last-child {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  /* ========================================
     CONTENU DU MENU
     ======================================== */

  .mobile-menu__content {
    position: relative;

    flex: 1;

    display: flex;
    align-items: center;

    width: min(calc(100% - 3rem), 350px);

    margin-inline: auto;
  }

  /* ========================================
     FIL VERTICAL
     ======================================== */

  .mobile-menu__thread {
    position: absolute;

    top: 50%;
    left: 17px;

    width: 46px;

    height: min(65vh, 520px);

    overflow: visible;

    transform: translateY(-50%);
  }

  .mobile-menu__thread path {
    fill: none;

    stroke: rgba(250, 247, 240, 0.58);

    stroke-width: 1.2;

    stroke-linecap: round;
    stroke-linejoin: round;

    vector-effect: non-scaling-stroke;
  }

  /* ========================================
     NAVIGATION
     ======================================== */

  .mobile-menu__nav {
    position: relative;

    z-index: 2;

    display: flex;
    flex-direction: column;

    width: 100%;

    padding-left: 4.5rem;
  }

  .mobile-menu__item {
    display: grid;

    grid-template-columns:
      2.2rem
      1fr;

    align-items: center;

    min-height: 66px;

    color: var(--color-ivory);

    opacity: 0;

    transform: translateX(18px);

    transition:
      transform var(--transition-base),
      opacity var(--transition-base);
  }

  .mobile-menu__item:hover,
  .mobile-menu__item:focus-visible {
    transform: translateX(6px);
  }

  .mobile-menu__number {
    font-size: 0.68rem;
    font-weight: 500;

    opacity: 0.72;
  }

  .mobile-menu__label {
    font-family: var(--font-body);

    font-size: clamp(1.15rem, 5vw, 1.45rem);

    font-weight: 400;

    letter-spacing: -0.015em;
  }

  /* ========================================
     APPARITION DES LIENS
     ======================================== */

  .is-open .mobile-menu__item {
    opacity: 1;

    transform: translateX(0);
  }

  .is-open .mobile-menu__item:nth-child(1) {
    transition-delay: 180ms;
  }

  .is-open .mobile-menu__item:nth-child(2) {
    transition-delay: 240ms;
  }

  .is-open .mobile-menu__item:nth-child(3) {
    transition-delay: 300ms;
  }

  .is-open .mobile-menu__item:nth-child(4) {
    transition-delay: 360ms;
  }

  .is-open .mobile-menu__item:nth-child(5) {
    transition-delay: 420ms;
  }

  /* ========================================
     ANNOTATION
     ======================================== */

  .mobile-menu__note {
    position: absolute;

    bottom: 2.5rem;
    left: 50%;

    margin: 0;

    font-family: var(--font-heading);

    font-size: 1.05rem;

    font-style: italic;

    white-space: nowrap;

    opacity: 0.72;

    transform: translateX(-50%) rotate(-4deg);
  }

  /* ========================================
     COIN INFÉRIEUR REPLIÉ
     ======================================== */

  .mobile-menu__fold {
    position: absolute;

    right: 0;
    bottom: 0;

    width: 62px;
    height: 62px;

    background: var(--color-ivory);

    clip-path: polygon(100% 0, 100% 100%, 0 100%);

    filter: drop-shadow(-4px -4px 7px rgba(11, 37, 48, 0.15));

    pointer-events: none;
  }

  /* ========================================
     DESKTOP
     ======================================== */

  @media (min-width: 1024px) {
    .mobile-menu {
      display: none;
    }
  }

  /* ========================================
     MOUVEMENTS RÉDUITS
     ======================================== */

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu__panel,
    .mobile-menu__item,
    .mobile-menu__trigger,
    .mobile-menu__trigger-image,
    .mobile-menu__close {
      transition: none;
    }
  }
</style>

<style is:global>
  body.menu-open {
    overflow: hidden;
  }
</style>
