---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" class="site-footer__logo" aria-label="Happyclicks — Accueil">
          <img
            src="/images/brand/happyclicks-logo-white.svg"
            alt="Happyclicks"
            width="260"
            height="64"
            loading="lazy"
            decoding="async"
          />
        </a>

        <p class="site-footer__signature">
          Chaque projet mérite son histoire<span>.</span>
        </p>
      </div>

      <nav class="site-footer__nav" aria-label="Navigation de pied de page">
        <a href="/realisations">Réalisations <span aria-hidden="true">→</span></a>
        <a href="/#services">Services <span aria-hidden="true">→</span></a>
        <a href="/#tarifs">Tarifs & délais <span aria-hidden="true">→</span></a>
        <a href="/#a-propos">À propos <span aria-hidden="true">→</span></a>
        <a href="/contact">Contact <span aria-hidden="true">→</span></a>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} Happyclicks</p>

      <div class="site-footer__legal">
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/politique-de-confidentialite">Confidentialité</a>
      </div>

      <a href="#top" class="site-footer__back-top" aria-label="Retour en haut de la page">
        <span>Retour en haut</span>
        <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--color-ink);
    color: var(--color-ivory);
    border-top: 1px solid rgba(250, 247, 240, 0.1);
  }

  .site-footer__inner {
    width: min(calc(100% - 2rem), var(--content-max));
    margin-inline: auto;
    padding-top: clamp(3rem, 5vw, 4.5rem);
    padding-bottom: 2rem;
  }

  .site-footer__top {
    display: grid;
    gap: 4rem;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .site-footer__brand {
    max-width: 430px;
  }

  .site-footer__logo {
    display: inline-block;
    width: 190px;
  }

  .site-footer__logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .site-footer__signature {
    margin-top: 2rem;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3vw, 3.3rem);
    line-height: 1;
    color: var(--color-ivory);
  }

  .site-footer__signature span {
    color: var(--color-coral);
  }

  .site-footer__nav {
    display: grid;
    align-content: start;
    gap: 0;
  }

  .site-footer__nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1rem;
    border-bottom: 1px solid rgba(250, 247, 240, 0.14);
    font-size: 0.95rem;
    transition:
      color var(--transition-base),
      padding-left var(--transition-base);
  }

  .site-footer__nav a:first-child {
    border-top: 1px solid rgba(250, 247, 240, 0.14);
  }

  .site-footer__nav a span {
    color: var(--color-teal);
    transition: transform var(--transition-base);
  }

  .site-footer__nav a:hover,
  .site-footer__nav a:focus-visible {
    color: var(--color-teal);
    padding-left: 0.4rem;
  }

  .site-footer__nav a:hover span,
  .site-footer__nav a:focus-visible span {
    transform: translateX(5px);
  }

  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(250, 247, 240, 0.1);
    color: rgba(250, 247, 240, 0.58);
    font-size: 0.74rem;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .site-footer__legal a,
  .site-footer__back-top {
    transition: color var(--transition-base);
  }

  .site-footer__legal a:hover,
  .site-footer__legal a:focus-visible,
  .site-footer__back-top:hover,
  .site-footer__back-top:focus-visible {
    color: var(--color-ivory);
  }

  .site-footer__back-top {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    width: fit-content;
  }

  .site-footer__back-top span:last-child {
    color: var(--color-teal);
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      width: min(calc(100% - 4rem), var(--content-max));
    }

    .site-footer__top {
      grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
      gap: clamp(5rem, 12vw, 12rem);
    }

    .site-footer__logo {
      width: 230px;
    }

    .site-footer__bottom {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
    }

    .site-footer__legal {
      margin-left: auto;
    }

    .site-footer__back-top {
      margin-left: 2rem;
    }
  }

  @media (max-width: 767px) {
    .site-footer__inner {
      padding-top: 3.5rem;
    }

    .site-footer__top {
      gap: 3.5rem;
      padding-bottom: 4rem;
    }

    .site-footer__logo {
      width: 165px;
    }

    .site-footer__signature {
      max-width: 290px;
      margin-top: 1.5rem;
      font-size: 2.2rem;
    }

    .site-footer__nav a {
      min-height: 54px;
    }

    .site-footer__bottom {
      padding-bottom: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__nav a,
    .site-footer__nav a span {
      transition: none;
    }
  }
</style>
