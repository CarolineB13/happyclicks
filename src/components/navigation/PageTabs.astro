---
const currentPath = Astro.url.pathname;

const items = [
  {
    number: "01",
    label: "Réalisations",
    href: "/realisations",
    icon: "projects",
  },
  {
    number: "02",
    label: "Votre projet",
    href: "/votre-projet",
    icon: "project",
  },
  {
    number: "03",
    label: "À propos",
    href: "/a-propos",
    icon: "about",
  },
  {
    number: "04",
    label: "Journal",
    href: "/journal",
    icon: "journal",
  },
  {
    number: "05",
    label: "Contact",
    href: "/contact",
    icon: "contact",
  },
];
---

<nav class="page-tabs" aria-label="Navigation principale">
  {
    items.map((item) => {
      const isActive = currentPath === item.href;

      return (
        <a
          class:list={[
            "page-tabs__item",
            { "page-tabs__item--active": isActive },
          ]}
          href={item.href}
          aria-current={isActive ? "page" : undefined}
        >
          <span class="page-tabs__number">{item.number}</span>

          <span class="page-tabs__icon" aria-hidden="true">
            {item.icon === "projects" && (
              <svg viewBox="0 0 24 24">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="M7 15l3.2-3.3 2.7 2.5 2.3-2.2L19 16" />
                <circle cx="8" cy="9" r="1.2" />
              </svg>
            )}

            {item.icon === "project" && (
              <svg viewBox="0 0 24 24">
                <path d="M12 21s7-4.3 7-10.2A4.3 4.3 0 0 0 12 7.5a4.3 4.3 0 0 0-7 3.3C5 16.7 12 21 12 21Z" />
                <path d="M12 7.5V4" />
                <path d="M10.5 5.5 12 4l1.5 1.5" />
              </svg>
            )}

            {item.icon === "about" && (
              <svg viewBox="0 0 24 24">
                <circle cx="12" cy="8" r="3.2" />
                <path d="M5.5 20c.6-4 3-6 6.5-6s5.9 2 6.5 6" />
              </svg>
            )}

            {item.icon === "journal" && (
              <svg viewBox="0 0 24 24">
                <path d="m4 20 4.2-1 10-10a2 2 0 0 0-2.8-2.8l-10 10L4 20Z" />
                <path d="m13.8 7.8 2.8 2.8" />
              </svg>
            )}

            {item.icon === "contact" && (
              <svg viewBox="0 0 24 24">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m4 7 8 6 8-6" />
              </svg>
            )}
          </span>

          <span class="page-tabs__label">{item.label}</span>
        </a>
      );
    })
  }
</nav>

<style>
  .page-tabs {
    position: fixed;
    top: 50%;
    right: 0;
    z-index: var(--z-navigation);

    display: none;
    flex-direction: column;
    gap: 0.35rem;

    transform: translateY(-50%);
  }

  .page-tabs__item {
    position: relative;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;

    width: 142px;
    min-height: 86px;

    padding: 0.9rem 1rem 0.9rem 1.2rem;

    background: var(--color-ivory);

    border: 1px solid rgba(11, 37, 48, 0.14);
    border-right: 0;
    border-radius: 18px 0 0 18px;

    box-shadow:
      -5px 4px 14px rgba(11, 37, 48, 0.06),
      -1px 1px 3px rgba(11, 37, 48, 0.08);

    transform: translateX(24px);

    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base),
      background-color var(--transition-base);
  }

  /* Petit effet de page légèrement soulevée */
  .page-tabs__item::before {
    content: "";
    position: absolute;

    top: -1px;
    left: -1px;

    width: 22px;
    height: 22px;

    background: linear-gradient(
      135deg,
      rgba(11, 37, 48, 0.08) 0%,
      rgba(11, 37, 48, 0.02) 42%,
      transparent 43%
    );

    border-radius: 17px 0 0 0;

    opacity: 0.35;

    transition:
      opacity var(--transition-base),
      transform var(--transition-base);
  }

  .page-tabs__item:hover,
  .page-tabs__item:focus-visible {
    transform: translateX(0) rotate(-0.35deg);

    box-shadow:
      -9px 6px 20px rgba(11, 37, 48, 0.09),
      -2px 2px 4px rgba(11, 37, 48, 0.08);
  }

  .page-tabs__item:hover::before,
  .page-tabs__item:focus-visible::before {
    opacity: 0.8;
    transform: translate(2px, 2px);
  }

  .page-tabs__number {
    margin-bottom: 0.35rem;

    color: var(--color-teal);

    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .page-tabs__label {
    color: var(--color-ink);

    font-size: 0.82rem;
    font-weight: 500;

    white-space: nowrap;
  }

  .page-tabs__icon {
    position: absolute;

    top: 16px;
    right: 44px;

    width: 20px;
    height: 20px;

    color: var(--color-teal);
    opacity: 0.8;

    transition:
      transform var(--transition-base),
      opacity var(--transition-base);
  }

  .page-tabs__icon svg {
    display: block;
    width: 100%;
    height: 100%;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .page-tabs__item:hover .page-tabs__icon,
  .page-tabs__item:focus-visible .page-tabs__icon {
    opacity: 1;
    transform: translateY(-2px);
  }

  /* Page actuellement visitée */
  .page-tabs__item--active {
    background: var(--color-mist);
  }

  .page-tabs__item--active .page-tabs__number,
  .page-tabs__item--active .page-tabs__icon {
    color: var(--color-teal);
  }

  @media (min-width: 1024px) {
    .page-tabs {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-tabs__item,
    .page-tabs__item::before,
    .page-tabs__icon {
      transition: none;
    }
  }
</style>
