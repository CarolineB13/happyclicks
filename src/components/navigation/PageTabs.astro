---
const currentPath = Astro.url.pathname;

const items = [
  { label: "Réalisations", href: "/realisations", icon: "projects" },
  { label: "Services", href: "/#services", icon: "services" },
  { label: "Tarifs", href: "/#tarifs", icon: "pricing" },
  { label: "À propos", href: "/#a-propos", icon: "about" },
  { label: "Contact", href: "/contact", icon: "contact" },
];
---

<nav class="page-tabs" aria-label="Navigation principale">
  {items.map((item) => {
    const isActive =
      (item.href === "/contact" && currentPath === "/contact") ||
      (item.href === "/realisations" && currentPath.startsWith("/realisations"));

    return (
      <a
        class:list={["page-tabs__item", { "page-tabs__item--active": isActive }]}
        href={item.href}
        aria-current={isActive ? "page" : undefined}
        aria-label={item.label}
      >
        <span class="page-tabs__icon" aria-hidden="true">
          {item.icon === "projects" && (
            <svg viewBox="0 0 24 24">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="M7 15l3.2-3.3 2.7 2.5 2.3-2.2L19 16" />
              <circle cx="8" cy="9" r="1.2" />
            </svg>
          )}

          {item.icon === "services" && (
            <svg viewBox="0 0 24 24">
              <path d="M4 7h16" />
              <path d="M4 12h12" />
              <path d="M4 17h8" />
            </svg>
          )}

          {item.icon === "pricing" && (
            <svg viewBox="0 0 24 24">
              <path d="M5 7.5h14v9H5z" />
              <path d="M8 10h5" />
              <path d="M8 13.5h8" />
            </svg>
          )}

          {item.icon === "about" && (
            <svg viewBox="0 0 24 24">
              <circle cx="12" cy="8" r="3.2" />
              <path d="M5.5 20c.6-4 3-6 6.5-6s5.9 2 6.5 6" />
            </svg>
          )}

          {item.icon === "contact" && (
            <svg viewBox="0 0 24 24">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m4 7 8 6 8-6" />
            </svg>
          )}
        </span>

        <span class="page-tabs__label">{item.label}</span>
      </a>
    );
  })}
</nav>

<style>
  .page-tabs {
    position: fixed;
    top: 50%;
    right: 0;
    z-index: var(--z-navigation);
    display: none;
    flex-direction: column;
    gap: 0.4rem;
    width: 160px;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .page-tabs__item {
    position: relative;
    display: flex;
    align-items: center;
    width: 160px;
    min-height: 66px;
    padding: 0 18px;
    overflow: hidden;
    background: var(--color-ivory);
    border: 1px solid rgba(11, 37, 48, 0.14);
    border-right: 0;
    border-radius: 18px 0 0 18px;
    box-shadow:
      -5px 4px 14px rgba(11, 37, 48, 0.06),
      -1px 1px 3px rgba(11, 37, 48, 0.08);
    transform: translateX(106px);
    transition:
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow var(--transition-base),
      background-color var(--transition-base);
    pointer-events: auto;
  }

  .page-tabs__item:hover,
  .page-tabs__item:focus-visible {
    transform: translateX(0);
    box-shadow:
      -9px 6px 20px rgba(11, 37, 48, 0.09),
      -2px 2px 4px rgba(11, 37, 48, 0.08);
  }

  .page-tabs__icon {
    flex: 0 0 22px;
    width: 22px;
    height: 22px;
    color: var(--color-teal);
    opacity: 0.95;
  }

  .page-tabs__icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .page-tabs__label {
    margin-left: 1rem;
    color: var(--color-ink);
    font-size: 0.84rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .page-tabs__item--active {
    background: var(--color-mist);
  }

  @media (min-width: 1024px) {
    .page-tabs {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-tabs__item {
      transition: none;
    }
  }
</style>
