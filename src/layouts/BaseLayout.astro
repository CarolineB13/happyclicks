---
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/600.css";
import "@fontsource/dm-serif-display/400.css";

import "../styles/variables.css";
import "../styles/typography.css";
import "../styles/global.css";
import "../styles/animations.css";

import Header from "../components/navigation/Header.astro";
import PageTabs from "../components/navigation/PageTabs.astro";
import MobileMenu from "../components/navigation/MobileMenu.astro";
import Footer from "../components/navigation/Footer.astro";
import WhatsAppButton from "../components/ui/WhatsAppButton.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title = "Création de sites internet sur mesure | Happyclicks",
  description = "Happyclicks conçoit et développe des sites internet sur mesure pour TPE, artisans et indépendants, sans template prêt à remplir.",
  noindex = false,
  ogType = "website",
  ogImage = "/images/og/happyclicks-og.png",
  ogImageAlt = "Happyclicks — Création de sites web sur mesure",
} = Astro.props;

const siteOrigin = Astro.site ?? new URL("https://happyclicks.fr");
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin);
const ogImageUrl = new URL(ogImage, siteOrigin);
const robotsContent = noindex ? "noindex, follow" : "index, follow";
const isHomePage = Astro.url.pathname === "/";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Happyclicks",
  legalName: "Caroline Briois — Entrepreneur individuel",
  url: "https://happyclicks.fr/",
  description: "Création et refonte de sites internet sur mesure pour TPE, artisans et indépendants.",
  logo: "https://happyclicks.fr/images/brand/happyclicks-logo-color.svg",
  email: "mailto:contact@happyclicks.fr",
  telephone: "+33650354556",
  address: {
    "@type": "PostalAddress",
    streetAddress: "201 rue Paul Vaufrey",
    postalCode: "83170",
    addressLocality: "Brignoles",
    addressCountry: "FR",
  },
  areaServed: {
    "@type": "Country",
    name: "France",
  },
  founder: {
    "@type": "Person",
    name: "Caroline Briois",
  },
  contactPoint: {
    "@type": "ContactPoint",
    telephone: "+33650354556",
    email: "contact@happyclicks.fr",
    contactType: "customer service",
    availableLanguage: "fr",
  },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Happyclicks",
  url: "https://happyclicks.fr/",
  inLanguage: "fr-FR",
  publisher: {
    "@type": "Organization",
    name: "Happyclicks",
    url: "https://happyclicks.fr/",
  },
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#faf7f0" />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Happyclicks" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{title}</title>

    {
      isHomePage && (
        <>
          <script
            type="application/ld+json"
            set:html={JSON.stringify(organizationSchema)}
          />
          <script
            type="application/ld+json"
            set:html={JSON.stringify(websiteSchema)}
          />
        </>
      )
    }
  </head>

  <body id="top">
    <Header />
    <PageTabs />
    <MobileMenu />

    <slot />

    <Footer />
    <WhatsAppButton />

    <script>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!reduceMotion) {
        document.body.classList.add("motion-ready");

        const groups = [
          { selector: "main section header, .contact-hero__inner, .legal-hero .legal-shell, .privacy-hero .privacy-shell", mode: "reveal-scale" },
          { selector: ".project, .pricing-card, .technical-card, .contact-aside__card, .legal-card, .privacy-card", mode: "reveal-scale" },
          { selector: ".contact-direct, .contact-form-intro, .contact-form, .pricing-section__extra, .pricing-section__note, .technical-block", mode: "" },
          { selector: ".services-section article, .brand-values-section article, .project-journey-section article, .story-section article", mode: "" },
        ];

        const targets = [];

        groups.forEach(({ selector, mode }) => {
          document.querySelectorAll(selector).forEach((element, index) => {
            if (element.classList.contains("reveal-target")) return;
            element.classList.add("reveal-target");
            if (mode) element.classList.add(mode);
            element.style.setProperty("--reveal-delay", `${Math.min(index % 4, 3) * 75}ms`);
            targets.push(element);
          });
        });

        const observer = new IntersectionObserver(
          (entries, currentObserver) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              currentObserver.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.08 }
        );

        targets.forEach((target) => observer.observe(target));
      }
    </script>
  </body>
</html>
