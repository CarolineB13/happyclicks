---
import "../styles/variables.css";
import "../styles/typography.css";
import "../styles/global.css";
import "../styles/animations.css";

import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/600.css";
import "@fontsource/dm-serif-display/400.css";

import Header from "../components/navigation/Header.astro";
import PageTabs from "../components/navigation/PageTabs.astro";
import MobileMenu from "../components/navigation/MobileMenu.astro";
import Footer from "../components/navigation/Footer.astro";
import WhatsAppButton from "../components/ui/WhatsAppButton.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
}

const {
  title = "Création de site internet sur mesure | Happyclicks",
  description = "Happyclicks crée des sites internet sur mesure pour TPE, artisans et indépendants : création, refonte, identité visuelle et accompagnement technique, partout en France.",
  noindex = false,
  ogType = "website",
} = Astro.props;

const siteOrigin = Astro.site ?? new URL("https://happyclicks.fr");
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin);
const robotsContent = noindex ? "noindex, follow" : "index, follow";
const isHomePage = Astro.url.pathname === "/";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Happyclicks",
  legalName: "Caroline Briois — Entrepreneur individuel",
  url: "https://happyclicks.fr/",
  logo: "https://happyclicks.fr/images/brand/happyclicks-logo-color.svg",
  email: "mailto:caroline.briois@happyclicks.fr",
  telephone: "+33650354556",
  address: {
    "@type": "PostalAddress",
    streetAddress: "201 rue Paul Vaufrey",
    postalCode: "83170",
    addressLocality: "Brignoles",
    addressCountry: "FR",
  },
  areaServed: {
    "@type": "Country",
    name: "France",
  },
  founder: {
    "@type": "Person",
    name: "Caroline Briois",
  },
  contactPoint: {
    "@type": "ContactPoint",
    telephone: "+33650354556",
    email: "caroline.briois@happyclicks.fr",
    contactType: "customer service",
    availableLanguage: "fr",
  },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Happyclicks",
  url: "https://happyclicks.fr/",
  inLanguage: "fr-FR",
  publisher: {
    "@type": "Organization",
    name: "Happyclicks",
    url: "https://happyclicks.fr/",
  },
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Happyclicks" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#faf7f0" />

    <title>{title}</title>

    {
      isHomePage && (
        <>
          <script
            type="application/ld+json"
            set:html={JSON.stringify(organizationSchema)}
          />
          <script
            type="application/ld+json"
            set:html={JSON.stringify(websiteSchema)}
          />
        </>
      )
    }
  </head>

  <body id="top">
    <Header />
    <PageTabs />
    <MobileMenu />

    <slot />

    <Footer />
    <WhatsAppButton />
  </body>
</html>
