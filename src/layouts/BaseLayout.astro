---
import "../styles/variables.css";
import "../styles/typography.css";
import "../styles/global.css";
import "../styles/animations.css";

import Header from "../components/navigation/Header.astro";
import PageTabs from "../components/navigation/PageTabs.astro";
import MobileMenu from "../components/navigation/MobileMenu.astro";
import Footer from "../components/navigation/Footer.astro";
import WhatsAppButton from "../components/ui/WhatsAppButton.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Happyclicks — Création de sites web sur mesure",
  description = "Happyclicks crée des sites web sur mesure, élégants et pensés pour être réellement utiles à votre activité : visibilité, confiance et prise de contact.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Serif+Display&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>

  <body id="top">
    <Header />
    <PageTabs />
    <MobileMenu />

    <slot />

    <Footer />
    <WhatsAppButton />
  </body>
</html>
